generator client {
  provider   = "prisma-client-js"
  output     = "../src/generated/prisma"
  engineType = "binary"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  SUBADMIN
  OWNER
  DEALER
  BUYER
  AGENT
  INVESTOR
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ListingType {
  SALE
  RENT
}

enum PropertyType {
  APARTMENT
  VILLA
  INDEPENDENT_HOUSE
  PLOT
  COMMERCIAL
  OFFICE
}

enum PropertyStatus {
  AVAILABLE
  SOLD
  RENTED
}

enum PropertyCondition {
  NEW_BOOKING
  RESALE
}

enum ProjectStatus {
  UPCOMING
  UNDER_CONSTRUCTION
  READY_TO_MOVE
}

enum PropertyImageCategory {
  EXTERIOR
  LIVING_ROOM
  BEDROOM
  KITCHEN
  BATHROOM
  DINING
  BALCONY
  FLOOR_PLAN
  OTHER
}

model User {
  id              String          @id @default(cuid())
  name            String
  email           String?         @unique
  phone           String?
  company         String?
  slug            String?         @unique
  about           String?         @db.Text
  logoUrl         String?
  licenseNumber   String?
  address         String?         @db.Text
  website         String?
  instagramUrl    String?
  facebookUrl     String?
  passwordHash    String?
  role            Role            @default(OWNER)
  verified        Boolean         @default(false)
  properties      Property[]
  subscriptions   Subscription[]
  leadViews       LeadView[]
  savedProperties SavedProperty[]
  enquiries       Enquiry[]       @relation("EnquiryBuyer")
  createdAt       DateTime        @default(now())

  agentProfile         AgentProfile?
  investorProfile      InvestorProfile?
  propertyUnlocks      PropertyUnlock[]
  dispatchRequests     DispatchRequest[]
  goldListingPurchases GoldListingPurchase[]
  visitAppointments    VisitAppointment[]
}

enum PlanRole {
  OWNER
  DEALER
  BOTH
  AGENT
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

model Plan {
  id            String         @id @default(cuid())
  name          String
  role          PlanRole       @default(BOTH)
  listingLimit  Int
  leadLimit     Int?
  price         Int            @default(0)
  durationDays  Int?
  active        Boolean        @default(true)
  subscriptions Subscription[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId    String
  plan      Plan               @relation(fields: [planId], references: [id], onDelete: Cascade)
  status    SubscriptionStatus @default(ACTIVE)
  amount    Int?
  startDate DateTime           @default(now())
  endDate   DateTime?
  createdAt DateTime           @default(now())

  @@index([userId])
  @@index([planId])
}

model LeadView {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enquiryId String
  enquiry   Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, enquiryId])
  @@index([userId])
}

model Developer {
  id              String    @id @default(cuid())
  slug            String    @unique
  name            String
  logoUrl         String?
  about           String?   @db.Text
  website         String?
  city            String?
  locality        String?
  contactEmail    String?
  contactPhone    String?
  verified        Boolean   @default(false)
  metaTitle       String?
  metaDescription String?   @db.Text
  projects        Project[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Project {
  id              String         @id @default(cuid())
  slug            String         @unique
  name            String
  description     String         @db.Text
  status          ProjectStatus  @default(UPCOMING)
  developerId     String
  developer       Developer      @relation(fields: [developerId], references: [id], onDelete: Cascade)
  city            String
  locality        String?
  address         String?        @db.Text
  priceMin        Int?
  priceMax        Int?
  possessionDate  DateTime?
  amenities       String?        @db.Text
  reraNumber      String?
  metaTitle       String?
  metaDescription String?        @db.Text
  units           Property[]
  images          ProjectImage[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([developerId])
}

model ProjectImage {
  id        String  @id @default(cuid())
  url       String
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  order     Int     @default(0)
}

model Country {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  states    State[]
  createdAt DateTime @default(now())
}

model State {
  id        String   @id @default(cuid())
  name      String
  slug      String
  countryId String
  country   Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  cities    City[]
  createdAt DateTime @default(now())

  @@unique([countryId, slug])
  @@index([countryId])
}

model City {
  id              String     @id @default(cuid())
  name            String
  slug            String     @unique
  stateId         String
  state           State      @relation(fields: [stateId], references: [id], onDelete: Cascade)
  localities      Locality[]
  latitude        Float?
  longitude       Float?
  heroImage       String?
  metaTitle       String?
  metaDescription String?    @db.Text
  description     String?    @db.Text
  published       Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([stateId])
}

model Locality {
  id              String   @id @default(cuid())
  name            String
  slug            String
  cityId          String
  city            City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  latitude        Float?
  longitude       Float?
  heroImage       String?
  metaTitle       String?
  metaDescription String?  @db.Text
  description     String?  @db.Text
  published       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([cityId, slug])
  @@index([cityId])
}

model Property {
  id              String             @id @default(cuid())
  title           String
  slug            String             @unique
  description     String             @db.Text
  listingType     ListingType
  propertyType    PropertyType
  condition       PropertyCondition?
  status          PropertyStatus     @default(AVAILABLE)
  approvalStatus  ApprovalStatus     @default(PENDING)
  expiresAt       DateTime?
  price           Int
  priceNegotiable Boolean            @default(false)
  bedrooms        Int?
  bathrooms       Int?
  areaSqft        Int?
  city            String
  locality        String?
  address         String?            @db.Text
  amenities       String?            @db.Text
  brochureUrl     String?
  youtubeUrl      String?
  ownerId         String
  owner           User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  projectId       String?
  project         Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  contactName     String?
  contactPhone    String?
  contactEmail    String?
  featured        Boolean            @default(false)
  metaTitle       String?
  metaDescription String?            @db.Text
  images          PropertyImage[]
  enquiries       Enquiry[]
  savedBy         SavedProperty[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([ownerId])
  @@index([projectId])
  @@index([city])
}

model PropertyImage {
  id         String                @id @default(cuid())
  url        String
  category   PropertyImageCategory @default(OTHER)
  propertyId String
  property   Property              @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  order      Int                   @default(0)
}

model Enquiry {
  id         String     @id @default(cuid())
  name       String
  phone      String
  email      String?
  message    String?    @db.Text
  propertyId String?
  property   Property?  @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  buyerId    String?
  buyer      User?      @relation("EnquiryBuyer", fields: [buyerId], references: [id], onDelete: SetNull)
  leadViews  LeadView[]
  createdAt  DateTime   @default(now())

  @@index([buyerId])
}

enum OtpChannel {
  WHATSAPP
  EMAIL
}

model OtpCode {
  id         String     @id @default(cuid())
  identifier String
  channel    OtpChannel
  code       String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([identifier])
}

model SavedProperty {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
}

model Amenity {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model SiteSettings {
  id                     String  @id @default("singleton")
  siteName               String  @default("BayaEstate")
  tagline                String? @db.Text
  logoUrl                String?
  favicon                String?
  heroImage              String?
  heroTitle              String?
  heroSubtitle           String?
  ctaText                String?
  ctaLink                String?
  whatsappNumber         String?
  contactEmail           String?
  contactPhone           String?
  contactAddress         String? @db.Text
  instagramUrl           String?
  facebookUrl            String?
  youtubeUrl             String?
  linkedinUrl            String?
  footerText             String? @db.Text
  metaTitle              String?
  metaDescription        String? @db.Text
  ogImage                String?
  googleAnalyticsId      String?
  googleSiteVerification String?
  tdsPercent             Int     @default(5)

  // Commission & payout rates — docs/platform-requirements.md §3.11-§3.14,
  // §3.17. All admin-editable from /admin/settings so nothing here is a
  // hardcoded constant the client would need a code change to adjust.
  brokeragePercent           Int @default(1) // §3.12 — 1% each side of a deal
  profitAgentSharePercent    Int @default(10) // §3.13 — investor+company deal profit split
  profitExpenseSharePercent  Int @default(10)
  profitInvestorSharePercent Int @default(40) // companyShare is always the remainder
  investorRegistrationFee    Int @default(20000) // §3.11 — new investor registrations only
  investorReferralPercent    Int @default(10) // % of registrationFee credited to referring agent
  agentReferralPercent       Int @default(10) // §3.20 — % of a referred agent's first Prime payment
  unlockPassAmount           Int @default(100) // §3.3 — also reused by dispatch (§3.5/§6 item 2)
  unlockAgentSplitPercent    Int @default(50)
  goldListingAmount          Int @default(500) // §3.4
  goldAgentSplitPercent      Int @default(50)

  updatedAt DateTime @updatedAt
}

// --- Phase 1: Agent + Investor foundation (docs/platform-requirements.md §7) ---

enum AgentDocumentType {
  RERA_CERTIFICATE
  TRADE_LICENSE
  GST_CERTIFICATE
  OTHER
}

enum InvestorFeeStatus {
  PENDING
  PAID
}

enum CommissionType {
  REGISTRATION_REFERRAL
  DEAL_PROFIT_SHARE
  BROKERAGE
  UNLOCK_SPLIT
  GOLD_SPLIT
  AGENT_REFERRAL
}

model AgentProfile {
  id               String         @id @default(cuid())
  userId           String         @unique
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentCode        String?        @unique
  city             String?
  shopName         String?
  shopAddress      String?        @db.Text
  shopLatitude     Float?
  shopLongitude    Float?
  alternatePhone   String?
  yearsExperience  Int?
  staffCount       Int?
  reraNumber       String?
  gstNumber        String?
  status           ApprovalStatus @default(PENDING)
  rejectionReason  String?        @db.Text
  primeStatus      Boolean        @default(false)
  walletBalance    Int            @default(0)
  warningCount     Int            @default(0)
  ratingAvg        Float?         @default(0)
  verifiedAt       DateTime?
  // §3.20 — the agent who referred this agent (self-referential, same shape
  // as InvestorProfile.referringAgentId below). Nullable: most agents have
  // no referrer.
  referringAgentId String?
  referringAgent   AgentProfile?  @relation("AgentReferral", fields: [referringAgentId], references: [id])
  referredAgents   AgentProfile[] @relation("AgentReferral")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  documents             AgentDocument[]
  investors             InvestorProfile[]
  commissionEntries     CommissionLedgerEntry[]
  listings              AgentListing[]
  dealsAsBuyerAgent     Deal[]                  @relation("DealBuyerAgent")
  dealsAsSellerAgent    Deal[]                  @relation("DealSellerAgent")
  profitDistributions   ProfitDistribution[]
  payoutRequests        PayoutRequest[]
  dispatchNotifications DispatchNotification[]
  dispatchesAccepted    DispatchRequest[]       @relation("DispatchAccepted")
  broadcastsPosted      Broadcast[]
  broadcastResponses    BroadcastResponse[]
  chatMessagesSent      AgentChatMessage[]      @relation("ChatFrom")
  chatMessagesReceived  AgentChatMessage[]      @relation("ChatTo")
  visitLogs             PropertyVisitLog[]
  ratings               AgentRating[]
  warnings              AgentWarning[]
  customerBlocks        CustomerAgentBlock[]
  documentVaultItems    DocumentVaultItem[]
  visitAppointments     VisitAppointment[]
  areaAssignments       AreaAgentAssignment[]

  @@index([status])
  @@index([referringAgentId])
}

// "Company har Pincode ya Area Code ko specific Agents ke IDs ke sath link
// (map) kar deti hai... toh call random na jaakar sirf aur sirf unhi
// chuninda area agents ko jayegi" — Agent Registration doc, "Company Rules
// (Area-Wise Auto Allocation)". Admin-managed override on top of the
// default radius-based dispatch (src/lib/agentGeo.ts): when a dispatch's
// pincode has any assignments here, only these agents are notified for the
// first batch instead of the nearest-by-distance ones.
model AreaAgentAssignment {
  id        String       @id @default(cuid())
  pincode   String
  agentId   String
  agent     AgentProfile @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([pincode, agentId])
  @@index([pincode])
}

model AgentDocument {
  id             String            @id @default(cuid())
  agentProfileId String
  agentProfile   AgentProfile      @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)
  type           AgentDocumentType @default(OTHER)
  url            String
  createdAt      DateTime          @default(now())

  @@index([agentProfileId])
}

model InvestorProfile {
  id               String            @id @default(cuid())
  userId           String            @unique
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  investorCode     String?           @unique
  referringAgentId String
  referringAgent   AgentProfile      @relation(fields: [referringAgentId], references: [id])
  registrationFee  Int               @default(20000)
  feeStatus        InvestorFeeStatus @default(PENDING)
  feePaymentMode   PaymentMode?
  registeredAt     DateTime          @default(now())
  expiresAt        DateTime?
  totalInvested    Int               @default(0)
  createdAt        DateTime          @default(now())

  profitDistributions ProfitDistribution[]
  ledgerEntries       InvestorLedgerEntry[]
  documentVaultItems  DocumentVaultItem[]
  agreements          CustomerInvestorAgreement[]

  @@index([referringAgentId])
}

model CommissionLedgerEntry {
  id        String         @id @default(cuid())
  agentId   String
  agent     AgentProfile   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  type      CommissionType
  amount    Int
  refId     String?
  note      String?        @db.Text
  createdAt DateTime       @default(now())

  @@index([agentId])
}

// --- Phase 2: Listings + deduplication (docs/platform-requirements.md §7) ---

model MasterProperty {
  id        String   @id @default(cuid())
  masterId  String   @unique
  city      String
  locality  String?
  latitude  Float
  longitude Float
  createdAt DateTime @default(now())

  listings           AgentListing[]
  visitLogs          PropertyVisitLog[]
  documentVaultItems DocumentVaultItem[]
  visitAppointments  VisitAppointment[]

  @@index([city])
}

enum ListingSource {
  AGENT
  CUSTOMER_GOLD
}

model AgentListing {
  id               String         @id @default(cuid())
  masterPropertyId String
  masterProperty   MasterProperty @relation(fields: [masterPropertyId], references: [id], onDelete: Cascade)
  // Nullable: a Gold self-listing (§3.4) with no referring agent has no
  // agent at all — "company's number is shown... not any specific agent's."
  // When present on a CUSTOMER_GOLD listing, it's the *referring* agent
  // (who gets the 50% split), not necessarily who's actively selling it.
  agentId          String?
  agent            AgentProfile?  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  source           ListingSource  @default(AGENT)
  // AGENT listings go live immediately (unchanged Phase 2 behavior);
  // CUSTOMER_GOLD listings default PENDING and need admin moderation
  // ("anti-fake-listing check") before they're public or auto-injected.
  approvalStatus   ApprovalStatus @default(APPROVED)
  slug             String         @unique
  title            String
  description      String         @db.Text
  listingType      ListingType
  propertyType     PropertyType
  bedrooms         Int?
  bathrooms        Int?
  areaSqft         Int?
  price            Int
  exactAddress     String         @db.Text
  amenities        String?        @db.Text
  // §3.15 — nearest Metro/Railway/Bus/Hospital/Grocery, auto-pulled at
  // creation time, never typed manually. Distinct from `amenities` above
  // (on-property features like gym/pool), this is *nearby places*.
  nearbyAmenities  String?        @db.Text
  videoUrl         String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  images       AgentListingImage[]
  unlocks      PropertyUnlock[]
  goldPurchase GoldListingPurchase?

  @@index([masterPropertyId])
  @@index([agentId])
  @@index([source, approvalStatus])
}

model AgentListingImage {
  id             String       @id @default(cuid())
  url            String
  agentListingId String
  agentListing   AgentListing @relation(fields: [agentListingId], references: [id], onDelete: Cascade)
  order          Int          @default(0)
}

model PropertyUnlock {
  id             String       @id @default(cuid())
  agentListingId String
  agentListing   AgentListing @relation(fields: [agentListingId], references: [id], onDelete: Cascade)
  buyerId        String
  buyer          User         @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  amount         Int          @default(100)
  agentSplit     Int          @default(50)
  companySplit   Int          @default(50)
  createdAt      DateTime     @default(now())

  @@unique([agentListingId, buyerId])
  @@index([buyerId])
}

// The one-time ₹500 Gold Membership payment — §3.4. One per listing
// (that's the self-listing fee, not a per-unlock charge like PropertyUnlock
// above). agentSplit is 0 when the listing had no referring agent code.
model GoldListingPurchase {
  id              String       @id @default(cuid())
  agentListingId  String       @unique
  agentListing    AgentListing @relation(fields: [agentListingId], references: [id], onDelete: Cascade)
  buyerId         String
  buyer           User         @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  amount          Int          @default(500)
  agentSplit      Int          @default(0)
  companySplit    Int          @default(500)
  razorpayOrderId String?
  createdAt       DateTime     @default(now())
}

// --- Phase 3: Money automation (docs/platform-requirements.md §7) ---

enum PaymentMode {
  BANK_TRANSFER
  CHEQUE
  CASH
  UPI
  NETBANKING
}

enum PayoutStatus {
  PENDING
  PAID
  REJECTED
}

// Direct buyer/seller brokerage on a closed deal — §3.12. 1% each side, 100%
// to the respective agent (no company cut on this line, per the source doc).
model Deal {
  id               String        @id @default(cuid())
  dealValue        Int
  buyerAgentId     String?
  buyerAgent       AgentProfile? @relation("DealBuyerAgent", fields: [buyerAgentId], references: [id])
  sellerAgentId    String?
  sellerAgent      AgentProfile? @relation("DealSellerAgent", fields: [sellerAgentId], references: [id])
  buyerCommission  Int?
  sellerCommission Int?
  paymentMode      PaymentMode
  note             String?       @db.Text
  dealDate         DateTime      @default(now())
  createdAt        DateTime      @default(now())

  @@index([buyerAgentId])
  @@index([sellerAgentId])
}

// Investor+Company joint deal profit split — §3.13. 10% agent / 10% company
// expense / 40% investor / 40% company, computed in one action (the "Master
// Commission Calculator", §3.14).
model ProfitDistribution {
  id                String          @id @default(cuid())
  investorProfileId String
  investorProfile   InvestorProfile @relation(fields: [investorProfileId], references: [id], onDelete: Cascade)
  agentId           String
  agent             AgentProfile    @relation(fields: [agentId], references: [id])
  totalProfit       Int
  agentShare        Int
  expenseShare      Int
  investorShare     Int
  companyShare      Int
  paymentMode       PaymentMode
  note              String?         @db.Text
  distributedAt     DateTime        @default(now())

  @@index([investorProfileId])
  @@index([agentId])
}

// Investor-side ledger — Investor Portal's "date-wise profit ledger: date,
// customer transaction, hold duration (days), credited profit" (§3.14).
// Kept separate from AgentProfile's CommissionLedgerEntry: an investor's
// profit and an agent's commission are never the same line item.
model InvestorLedgerEntry {
  id                     String          @id @default(cuid())
  investorProfileId      String
  investorProfile        InvestorProfile @relation(fields: [investorProfileId], references: [id], onDelete: Cascade)
  amount                 Int
  customerTransactionRef String?
  holdDurationDays       Int?
  refId                  String?
  note                   String?         @db.Text
  createdAt              DateTime        @default(now())

  @@index([investorProfileId])
}

// Agent wallet → bank withdrawal, TDS deducted automatically before release
// (§3.14's "TDS & company-handling-charge deduction engine"). Wallet balance
// is reserved (decremented) at request time so an agent can't request more
// than they have; rejecting a request credits it back.
model PayoutRequest {
  id          String       @id @default(cuid())
  agentId     String
  agent       AgentProfile @relation(fields: [agentId], references: [id], onDelete: Cascade)
  grossAmount Int
  tdsPercent  Int
  tdsAmount   Int
  netAmount   Int
  status      PayoutStatus @default(PENDING)
  paymentMode PaymentMode?
  requestedAt DateTime     @default(now())
  processedAt DateTime?

  @@index([agentId])
  @@index([status])
}

// --- Phase 4: Geolocation & Dispatch (docs/platform-requirements.md §7) ---

enum DispatchStatus {
  SEARCHING
  MATCHED
  EXPIRED
  CANCELLED
}

// Uber-style cascade dispatch — §3.5. Trigger is the same ₹100 payment as the
// listing unlock pass (§3.3) — the client's own §3.17 monetization table has
// only one "₹100 unlock pass, 50/50 split" line item, not a separate dispatch
// fee, so this reuses that exact split rather than inventing a second charge.
model DispatchRequest {
  id                String         @id @default(cuid())
  buyerId           String
  buyer             User           @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  latitude          Float
  longitude         Float
  amount            Int            @default(100)
  agentSplit        Int            @default(50)
  companySplit      Int            @default(50)
  paymentMode       PaymentMode?
  razorpayOrderId   String?
  status            DispatchStatus @default(SEARCHING)
  currentRadiusKm   Int            @default(1)
  currentBatch      Int            @default(1)
  batchStartedAt    DateTime       @default(now())
  acceptedByAgentId String?
  acceptedAgent     AgentProfile?  @relation("DispatchAccepted", fields: [acceptedByAgentId], references: [id])
  acceptedAt        DateTime?
  createdAt         DateTime       @default(now())

  notifications DispatchNotification[]

  @@index([buyerId])
  @@index([status])
}

// One row per (dispatch, agent) the cascade has ever notified — also the
// idempotency guard against re-notifying the same agent in a later batch.
model DispatchNotification {
  id                String          @id @default(cuid())
  dispatchRequestId String
  dispatchRequest   DispatchRequest @relation(fields: [dispatchRequestId], references: [id], onDelete: Cascade)
  agentId           String
  agent             AgentProfile    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  batch             Int
  createdAt         DateTime        @default(now())

  @@unique([dispatchRequestId, agentId])
  @@index([agentId])
}

enum BroadcastStatus {
  OPEN
  CLOSED
}

// Agent-facing inventory-sourcing categories — Rent/Buy/Sell/Letout, all
// four, unlike the customer-facing Buy/Rent-only rule (§3.3 addendum). This
// enum is intentionally separate from the public-facing ListingType.
enum BroadcastTxnType {
  RENT
  BUY
  SELL
  LETOUT
}

// B2B agent-to-agent broadcast — §3.6. "Radius (1/3/5km) → Society →
// Flat size → Transaction type → Budget range", pure dropdowns, no free text.
model Broadcast {
  id        String           @id @default(cuid())
  agentId   String
  agent     AgentProfile     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  latitude  Float
  longitude Float
  radiusKm  Int
  society   String?
  flatSize  String
  txnType   BroadcastTxnType
  budgetMin Int
  budgetMax Int
  status    BroadcastStatus  @default(OPEN)
  createdAt DateTime         @default(now())

  responses BroadcastResponse[]
  messages  AgentChatMessage[]

  @@index([agentId])
  @@index([status])
}

// "I Have This Property" click — opens the Agent Code ↔ Agent Code chat.
model BroadcastResponse {
  id          String       @id @default(cuid())
  broadcastId String
  broadcast   Broadcast    @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  agentId     String
  agent       AgentProfile @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())

  @@unique([broadcastId, agentId])
  @@index([agentId])
}

// Encrypted-in-transit (HTTPS + Socket.io over TLS in production) Agent
// Code ↔ Agent Code chat, always scoped to the broadcast that started it —
// §3.6 doesn't describe a general-purpose DM, only a per-requirement thread.
model AgentChatMessage {
  id          String       @id @default(cuid())
  broadcastId String
  broadcast   Broadcast    @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  fromAgentId String
  fromAgent   AgentProfile @relation("ChatFrom", fields: [fromAgentId], references: [id], onDelete: Cascade)
  toAgentId   String
  toAgent     AgentProfile @relation("ChatTo", fields: [toAgentId], references: [id], onDelete: Cascade)
  message     String       @db.Text
  readAt      DateTime?
  createdAt   DateTime     @default(now())

  @@index([broadcastId])
  @@index([toAgentId])
}

// --- Phase 5: Trust & Retention (docs/platform-requirements.md §7) ---

// Immutable audit table — §3.8's anti-poaching/conflict protection. Rows are
// never edited or deleted; a conflict is a *new* row with isPrimaryOwner
// false, not a correction of the original.
model PropertyVisitLog {
  id                  String         @id @default(cuid())
  customerPhone       String
  customerName        String?
  masterPropertyId    String
  masterProperty      MasterProperty @relation(fields: [masterPropertyId], references: [id], onDelete: Cascade)
  agentId             String
  agent               AgentProfile   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  otpVerified         Boolean        @default(true)
  isPrimaryOwner      Boolean        @default(true)
  conflictWithAgentId String?
  visitedAt           DateTime       @default(now())

  @@index([customerPhone, masterPropertyId])
  @@index([agentId])
}

// 5-star rating + written review after a visit/deal — §3.9.
model AgentRating {
  id               String       @id @default(cuid())
  agentId          String
  agent            AgentProfile @relation(fields: [agentId], references: [id], onDelete: Cascade)
  customerPhone    String
  masterPropertyId String?
  stars            Int
  review           String?      @db.Text
  createdAt        DateTime     @default(now())

  @@index([agentId])
}

// 3-strike rule — §3.9: 3 verified complaints against one Agent Code →
// visible ranking drop + warning to both agent and customer.
model AgentWarning {
  id        String       @id @default(cuid())
  agentId   String
  agent     AgentProfile @relation(fields: [agentId], references: [id], onDelete: Cascade)
  reason    String       @db.Text
  createdAt DateTime     @default(now())

  @@index([agentId])
}

// A formal complaint permanently blocks that agent from ever being
// re-shown to this customer again — §3.9: "must never be re-shown to that
// same customer again for a new lead in the same area."
model CustomerAgentBlock {
  id            String       @id @default(cuid())
  customerPhone String
  agentId       String
  agent         AgentProfile @relation(fields: [agentId], references: [id], onDelete: Cascade)
  reason        String       @db.Text
  createdAt     DateTime     @default(now())

  @@unique([customerPhone, agentId])
  @@index([customerPhone])
}

// Abuse-guardrail ledger — §3.9: max 3 switch/buzzer actions per customer
// per day, 1-2hr cooldown between uses, mandatory reason before the switch
// button is even clickable.
model AgentSwitchLog {
  id            String   @id @default(cuid())
  customerPhone String
  fromAgentId   String
  toAgentId     String?
  reason        String   @db.Text
  isComplaint   Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([customerPhone])
}

enum DocumentVaultType {
  REGISTRY
  SALE_DEED
  AGREEMENT_TO_SELL
  ENCUMBRANCE_CERTIFICATE
  LAYOUT_PLAN
  PAYMENT_RECEIPT
  SIGNED_AGREEMENT
  OTHER
}

// §3.10 — "Access is code-scoped: visible only inside the relevant Agent
// Code / Investor Code dashboards." A vault item always belongs to exactly
// one of agentId/investorId (whichever dashboard it should surface in),
// optionally also tagged to a Master Property.
model DocumentVaultItem {
  id               String            @id @default(cuid())
  masterPropertyId String?
  masterProperty   MasterProperty?   @relation(fields: [masterPropertyId], references: [id], onDelete: Cascade)
  dealId           String?
  agentId          String?
  agent            AgentProfile?     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  investorId       String?
  investor         InvestorProfile?  @relation(fields: [investorId], references: [id], onDelete: Cascade)
  type             DocumentVaultType @default(OTHER)
  title            String
  url              String
  uploadedByUserId String
  createdAt        DateTime          @default(now())

  @@index([masterPropertyId])
  @@index([agentId])
  @@index([investorId])
}

// Customer↔Investor agreement record — §3.10's named sub-requirement:
// "customer name/contact, agreement date, lock-in period, flat/unit number,
// terms, signed copy upload."
model CustomerInvestorAgreement {
  id                 String          @id @default(cuid())
  investorId         String
  investor           InvestorProfile @relation(fields: [investorId], references: [id], onDelete: Cascade)
  customerName       String
  customerPhone      String
  agreementDate      DateTime
  lockInPeriodMonths Int?
  flatUnitNumber     String?
  terms              String?         @db.Text
  signedCopyUrl      String
  // "Investor ne customer ki property buy/book karne ke liye kitna payment
  // diya aur uska payment mode kya tha" — the Investor→Customer leg, tracked
  // separately from the Investor→Company registration-fee leg
  // (InvestorProfile.feePaymentMode).
  paymentAmount      Int?
  paymentMode        PaymentMode?
  createdAt          DateTime        @default(now())

  @@index([investorId])
}

// --- §3.7 Calendar / Meeting Board / CRM (unassigned to a numbered phase in
// §7's roadmap — built as the last remaining spec'd module) ---

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  NO_SHOW
  CANCELLED
}

// "Shared calendar slot booked between agent & customer for a site visit;
// both get reminders... full audit trail: visit date, inquiry date,
// follow-up due date" — §3.7. `bookingCode` is the customer's "existing
// unique booking code" the no-show escalation flow reuses.
model VisitAppointment {
  id               String            @id @default(cuid())
  bookingCode      String            @unique
  buyerId          String
  buyer            User              @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  agentId          String
  agent            AgentProfile      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  masterPropertyId String?
  masterProperty   MasterProperty?   @relation(fields: [masterPropertyId], references: [id], onDelete: SetNull)
  scheduledAt      DateTime
  status           AppointmentStatus @default(SCHEDULED)
  followUpDueAt    DateTime?
  reminderSentAt   DateTime?
  createdAt        DateTime          @default(now())

  @@index([buyerId])
  @@index([agentId])
  @@index([status])
}
