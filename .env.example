# MySQL/MariaDB connection string
DATABASE_URL="mysql://root:password@localhost:3306/bayaestate"

# Public site URL used for canonical links, sitemap, and structured data
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# NextAuth
AUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Local file uploads (property images)
UPLOADS_DIR="./public/uploads"
UPLOADS_URL_PREFIX="/uploads"

# Seeder: initial admin account
ADMIN_EMAIL="admin@bayaestate.com"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_NAME="BayaEstate Admin"

# WhatsApp Cloud API (Meta) — used for buyer OTP login + notifications.
# Phone Number ID and access token come from developers.facebook.com > your app > WhatsApp > API Setup.
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_API_VERSION="v21.0"
# Optional: name of an approved "Authentication" template in Meta Business Manager.
# Free-form text OTP messages only deliver if the buyer messaged you first within 24h —
# without an approved template, first-contact OTP delivery to new buyers can silently fail.
WHATSAPP_OTP_TEMPLATE_NAME=""

# Email (SMTP via nodemailer) — used as fallback for OTP + notifications.
# For Gmail: an "App Password" (not your normal password) — myaccount.google.com/apppasswords
EMAIL_SERVICE="gmail"
EMAIL_USER=""
EMAIL_APP_PASSWORD=""
EMAIL_FROM="BayaEstate <no-reply@bayaestate.com>"

# Razorpay — used for the ₹100 unlock pass (and, once wired up, investor/Prime
# payments). Key ID + Secret from dashboard.razorpay.com > Settings > API Keys.
# Leave blank to keep the existing simulated/admin-confirmed payment flow.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Redis — required for Phase 4 (Uber-style cascade dispatch + B2B broadcast/chat).
# Powers Socket.io's pub/sub adapter, BullMQ's batch-timeout queue, and the
# GEOADD/GEORADIUS agent-radius index (docs/platform-requirements.md §3.5's own
# suggested stack). Local dev: `docker run -d -p 6381:6379 redis:7-alpine`.
REDIS_URL="redis://localhost:6381"
